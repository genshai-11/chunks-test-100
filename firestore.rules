rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All campaign data is accessed through the Express API. The server uses
    // Firebase Admin credentials and enforces identity, consent, and quotas.
    // A browser Firebase SDK cannot bypass those transaction boundaries.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
