{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "chunkstest",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "remix-chunks-test-100",
          "region": "asia-east1"
        }
      }
    ]
  }
}
