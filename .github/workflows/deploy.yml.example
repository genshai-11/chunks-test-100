# Example GitHub Actions Continuous Deployment Workflow
# Triggered on push to main branch after all checks pass.
# Requires configuring GCP Workload Identity Federation (WIF).
# Do NOT store raw service account JSON keys in GitHub Secrets.

name: Deploy to Cloud Run

on:
  workflow_dispatch:
  # push:
  #   branches: [main]

permissions:
  contents: read
  id-token: write

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # 1. Authenticate with Google Cloud using Workload Identity Federation
