{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator account with operational privileges for Chunks Test 100",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "ops_admin"],
          "description": "Administrative access role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Chunker": {
      "title": "Chunker",
      "description": "Approved referring learner / member with unique referral code",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Chunker full name"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{3,20}$",
          "description": "Unique uppercase referral code (e.g., TUNG2026)"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Chunker email address"
        },
        "active": {
          "type": "boolean",
          "description": "Whether referral code is active"
        },
        "referralCount": {
          "type": "number",
          "description": "Cached total candidate registrations referred"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp created"
        }
      },
      "required": ["name", "code", "email", "active", "referralCount", "createdAt"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Registered candidate applying for 1-on-1 assessment test",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Candidate full name"
        },
        "phone": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "description": "Contact phone number for Zalo/SMS coordination"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Candidate email"
        },
        "ageRange": {
          "type": "string",
          "enum": ["<18", "18-24", "25-34", "35-44", "45+"],
          "description": "Candidate age bracket"
        },
        "occupation": {
          "type": "string",
          "maxLength": 100,
          "description": "Candidate occupation or industry"
        },
        "testType": {
          "type": "string",
          "enum": ["green", "red"],
          "description": "Selected assessment: green (Focus %c) or red (Improv %r)"
        },
        "testLevel": {
          "type": "string",
          "enum": ["easy", "hard"],
          "description": "Selected test difficulty level: easy (Dễ) or hard (Khó)"
        },
        "preferredSlots": {
          "type": "string",
          "maxLength": 250,
          "description": "Selected preferred scheduling windows"
        },
        "selectedDate": {
          "type": "string",
          "maxLength": 40,
          "description": "Calendar date chosen for 1-on-1 session"
        },
        "selectedTimeSlot": {
          "type": "string",
          "maxLength": 80,
          "description": "Specific time slot chosen on calendar (e.g. 19:00 - 19:45)"
        },
        "chunkerCode": {
          "type": "string",
          "maxLength": 30,
          "description": "Referral code from invitation link"
        },
        "chunkerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Cached name of referring Chunker"
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "scheduled", "completed", "noshow"],
          "description": "Operational scheduling status"
        },
        "confirmationEmailSent": {
          "type": "boolean",
          "description": "Whether automated confirmation email was dispatched to candidate"
        },
        "confirmationEmailSentAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when automated confirmation email was sent"
        },
        "confirmationEmailStatus": {
          "type": "string",
          "enum": ["delivered", "pending", "failed", "simulated"],
          "description": "Delivery status of confirmation email"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Operational notes by CiC or Ops"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last status modification timestamp"
        }
      },
      "required": ["fullName", "phone", "email", "ageRange", "occupation", "testType", "preferredSlots", "chunkerCode", "status", "createdAt"]
    },
    "TriggerMail": {
      "title": "TriggerMail",
      "description": "Outbox document queue consumed by Firebase Trigger Email extension or Cloud Functions",
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "description": "Recipient email address"
        },
        "message": {
          "type": "object",
          "description": "Email subject, HTML and text body payload"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Queue timestamp"
        }
      },
      "required": ["to", "message"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Application administrative settings including notification email addresses",
      "type": "object",
      "properties": {
        "notificationEmails": {
          "type": "array",
          "description": "Email addresses to notify upon new test registrations"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether email notifications are enabled"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last settings update timestamp"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email or UID of administrator who updated settings"
        }
      },
      "required": ["notificationEmails", "enabled"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Authorized administrators with elevated management permissions"
    },
    "/chunkers/{chunkerId}": {
      "schema": {
        "$ref": "#/entities/Chunker"
      },
      "description": "Chunker referrers with active referral codes and counts"
    },
    "/candidates/{candidateId}": {
      "schema": {
        "$ref": "#/entities/Candidate"
      },
      "description": "Candidate assessment registrations submitted through referral links"
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/SystemSetting"
      },
      "description": "System and administrative configurations such as email notification setup"
    },
    "/mail/{mailId}": {
      "schema": {
        "$ref": "#/entities/TriggerMail"
      },
      "description": "Trigger email documents processed by Firebase Trigger Email extension / Cloud Functions"
    }
  }
}
