# ==============================================================================
# CHUNKS TEST 100 — PRODUCTION ENVIRONMENT VARIABLES GUIDE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# The server uses a high-performance persistent SQLite engine located at:
# ./data/chunks.db (auto-created with WAL mode enabled).
#
# If connecting to an external PostgreSQL / Supabase instance in production, set:
# DATABASE_URL="postgresql://user:password@host:5432/chunks_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. EMAIL DELIVERY SERVICE (RESEND - RECOMMENDED)
# ------------------------------------------------------------------------------
# To enable real transactional emails to candidates and operations alerts,
# register an API key at https://resend.com and configure below:
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="CHUNKS Assessment <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 3. ALTERNATIVE: SMTP EMAIL CONFIGURATION (GMAIL / SENDGRID / AWS SES / POSTMARK)
# ------------------------------------------------------------------------------
# If not using Resend, configure your standard SMTP server credentials below:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@chunks.edu.vn"
SMTP_PASS="your-app-specific-password"
NOTIFICATION_FROM_EMAIL="chunks.operations@chunks.edu.vn"

# ------------------------------------------------------------------------------
# 4. ADMIN & OPERATIONS SECURITY
