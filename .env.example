# CHUNKS Test 100 server: Google Application Default Credentials must have
# access to project fourth-vehicle-452610-a1 and the named Firestore database.
# The database ID defaults to firebase-applet-config.json; override only for
# a dedicated emulator/staging database, never to point production at local data.
FIRESTORE_DATABASE_ID="ai-studio-remixchunkstest1-a42d45b2-bb93-4241-899a-c2cb84f510a5"

# Firebase Auth: admin ID tokens are verified server-side. Optional allowlist
# override; every address must have an email_verified Firebase identity.
ADMIN_EMAILS="le.ntmkh@gmail.com,lucy2511kh@gmail.com"

# Cloud Scheduler POST /api/internal/drain-email-outbox with OIDC identity.
# Audience is the exact Cloud Run service URL, not a user-controlled Host header.
OUTBOX_AUDIENCE="https://YOUR-SERVICE-URL.run.app"
OUTBOX_SCHEDULER_EMAIL="chunks-outbox-scheduler@YOUR-PROJECT.iam.gserviceaccount.com"

# Email Provider Configuration: Resend OR Gmail / Custom SMTP.
# If using Gmail (e.g. chunksstation@gmail.com), leave RESEND_API_KEY blank,
# generate an App Password from https://myaccount.google.com/apppasswords,
# and configure the SMTP_* variables below.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="chunksstation@gmail.com"
SMTP_PASS=""
SMTP_FROM="CHUNKS Operations <chunksstation@gmail.com>"

PORT=3000
NODE_ENV="development"
APP_URL="https://chunkstest.ai.studio"
